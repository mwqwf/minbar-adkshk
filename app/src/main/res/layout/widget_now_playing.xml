<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت الشاشة الرئيسية: آخر درس مع زر تشغيل/إيقاف. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="#CCFFFFFF" />
    </LinearLayout>

    <!-- 48dp مساحة لمسيّة والرسم يبقى 36dp بالحشو؛ كان 36dp صافية أي دون
         الحدّ الموصى به. والصبغة الذهبيّة تُدخل أيقونة النظام في هوية منبر.
         ⚠️ لا تستبدل src برسمة متجهية: minSdk=23 وRemoteViews لا تضمن
         VectorDrawable قبل API 24، فيسقط تضخيم الودجت كلّه على 6.0. -->
    <ImageView
        android:id="@+id/widget_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="6dp"
        android:src="@android:drawable/ic_media_play"
        android:tint="#FDD459"
        android:contentDescription="@string/widget_play" />
</LinearLayout>
