{
  "version": 2,
  "builds": [
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/catalog/?", "dest": "https://minbar-api.mushafak.workers.dev/v1/catalog" },
    { "src": "/listen/?", "dest": "/listen.html" },
    { "src": "/privacy/?", "dest": "/privacy.html" },
    { "src": "/admin-privacy/?", "dest": "/admin-privacy.html" },
    { "src": "/lesson/[^/]+/?", "dest": "/lesson.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
